# Shared server image for Render's Docker runtime, used by BOTH services:
#   atlas-sync (worker) — default CMD, runs node src/sync.js
#   atlas-api  (web)    — dockerCommand override in render.yaml runs node src/api.js
# Bundles a Tor daemon so either service can reach a Bitcoin node exposed as
# a Tor hidden service (Start9/Umbrel) — Render's native Node runtime cannot
# run Tor, hence this image. See README "Connecting a Start9 node", pattern 2.
FROM node:22-slim

# A font is required by atlas-api, not the worker: og.js rasterizes the share
# cards with sharp, which resolves font families through fontconfig. With no
# fonts installed at all, the SVG's font-family matched nothing and every glyph
# in every social preview rendered as .notdef tofu.
#
# DejaVu rather than the site's Inter: there is no Inter package in bookworm
# main. og.js asks for Inter first and falls back to DejaVu, so dropping real
# Inter TTFs into /usr/share/fonts later would upgrade the cards with no
# further change here.
RUN apt-get update \
  && apt-get install -y --no-install-recommends tor ca-certificates fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

# Tailscale, for reaching a node over a tailnet instead of Tor (README
# "Connecting a Start9 node", pattern 3). Inert unless TAILSCALE_AUTHKEY is
# set: the entrypoint only starts tailscaled (userspace networking + SOCKS5
# on 127.0.0.1:1055 — no TUN device, so it runs unprivileged as USER node)
# when the key is present. curl is build-time only, for the repo keyring.
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg \
       -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main" \
       > /etc/apt/sources.list.d/tailscale.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends tailscale \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY scripts ./scripts
COPY worker-entrypoint.sh ./
RUN chmod +x worker-entrypoint.sh

USER node

CMD ["./worker-entrypoint.sh"]
